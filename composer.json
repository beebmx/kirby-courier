{
  "name": "beebmx/kirby-courier",
  "description": "Courier offers a convenient and painless solution for creating emails tailored for your Kirby website.",
  "license": "MIT",
  "type": "kirby-plugin",
  "version": "2.0.1",
  "homepage": "https://github.com/beebmx/kirby-courier",
  "keywords": [
    "mail",
    "email",
    "courier",
    "kirby",
    "kirby-plugin",
    "kirby4",
    "kirby5",
    "kirby6"
  ],
  "authors": [
    {
      "name": "Fernando Gutierrez",
      "homepage": "https://beeb.mx"
    }
  ],
  "require": {
    "php": "^8.4",
    "getkirby/composer-installer": "^1.2",
    "tijsverkoyen/css-to-inline-styles": "^2.4"
  },
  "require-dev": {
    "getkirby/cli": "^2.0",
    "getkirby/cms": "^6.0",
    "laravel/pint": "^1.0",
    "pestphp/pest": "^5.0"
  },
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true,
      "pestphp/pest-plugin": true
    }
  },
  "autoload": {
    "files": [
      "helpers.php"
    ],
    "psr-4": {
      "Beebmx\\KirbyCourier\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "extra": {
    "kirby": {
      "compatible": "^4.0 || ^5.0 || ^6.0"
    },
    "kirby-cms-path": false,
    "kirby-plugin-path": "tests/Fixtures/site/plugins"
  },
  "scripts": {
    "test-setup": [
      "php tests/helpers.php",
      "vendor/bin/pest"
    ],
    "test": "@php -d auto_prepend_file=tests/constants.php vendor/bin/pest"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
